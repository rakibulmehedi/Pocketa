# -----------------------------------------------------------------------------
# Line endings - always LF (cross-platform safe)
# -----------------------------------------------------------------------------
* text=auto eol=lf

*.dart text diff=dart
*.yaml text
*.arb  text
*.json text
*.md   text
*.sh   text eol=lf

# -----------------------------------------------------------------------------
# Binary files - diff/merge disable
# -----------------------------------------------------------------------------
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary
*.keystore binary
*.jks   binary

*.svg   text

# -----------------------------------------------------------------------------
# Platform specific binaries
# -----------------------------------------------------------------------------
*.xcworkspace binary
*.xcuserstate binary
*.xcuserdata binary
*.a      binary
*.so     binary
*.dylib  binary
*.dll    binary
*.exe    binary

# -----------------------------------------------------------------------------
# Lock files
# -----------------------------------------------------------------------------
pubspec.lock text
yarn.lock    text
package-lock.json text
