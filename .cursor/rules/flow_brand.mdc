### Empathetic Messaging
```dart
// Use empathetic, non-judgmental language
class EmpatheticMessages {
  static String getOverBudgetMessage(String category, CulturalContext context) {
    switch (context.locale.languageCode) {
      case 'bn':
        return '${category} এ একটু বেশি খরচ হয়েছে। কোনো সমস্যা নেই—কখনো কখনো হয়।';
      case 'hi':
        return '${category} में थोड़ा ज्यादा खर्च हुआ है। कोई बात नहीं—कभी-कभी होता है।';
      default:
        return 'You spent a bit more on ${category} this time. No worries—it happens.';
    }
  }
}
```

### Cultural Greetings
```dart
// Time-aware cultural greetings
String getCulturalGreeting(CulturalContext context, DateTime time) {
  final hour = time.hour;
  switch (context.locale.languageCode) {
    case 'bn':
      if (hour < 12) return 'সুপ্রভাত';
      if (hour < 17) return 'শুভ দুপুর';
      if (hour < 20) return 'শুভ সন্ধ্যা';
      return 'রাতের শুভেচ্ছা';
    case 'hi':
      if (hour < 12) return 'सुप्रभात';
      if (hour < 17) return 'नमस्ते';
      if (hour < 20) return 'शुभ संध्या';
      return 'शुभ रात्रि';
    case 'ar':
      if (hour < 12) return 'صباح الخير';
      if (hour < 17) return 'مساء الخير';
      if (hour < 20) return 'مساء النور';
      return 'ليلة سعيدة';
    default:
      if (hour < 12) return 'Good morning';
      if (hour < 17) return 'Good afternoon';
      if (hour < 20) return 'Good evening';
      return 'Good night';
  }
}
```

