### Typography
```dart
// Flow typography system
class FlowTypography {
  static const String latinFont = 'Inter';
  static const String bengaliFont = 'Hind Siliguri';
  static const String hindiFont = 'Noto Sans Devanagari';
  static const String arabicFont = 'Noto Sans Arabic';
  
  static TextStyle getHeading(CulturalContext context) {
    return TextStyle(
      fontFamily: _getFontFamily(context),
      fontSize: 24,
      fontWeight: FontWeight.bold,
    );
  }
  
  static String _getFontFamily(CulturalContext context) {
    switch (context.locale.languageCode) {
      case 'bn': return bengaliFont;
      case 'hi': return hindiFont;
      case 'ar': return arabicFont;
      default: return latinFont;
    }
  }
}
```

