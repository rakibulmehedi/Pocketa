# Flutter Development Patterns

## Widget Lifecycle and State Management

### 1. StatelessWidget Best Practices
```dart
// ✅ Good - const constructor and const child widgets
class MyWidget extends StatelessWidget {
  const MyWidget({
    super.key,
    required this.title,
    this.subtitle,
  });
  
  final String title;
  final String? subtitle;
  
  @override
  Widget build(BuildContext context) {
    return Column(
      children: [
        Text(title),
        if (subtitle != null) Text(subtitle!),
      ],
    );
  }
}
```

### 2. StatefulWidget Best Practices
```dart
class MyStatefulWidget extends StatefulWidget {
  const MyStatefulWidget({super.key});
  
  @override
  State<MyStatefulWidget> createState() => _MyStatefulWidgetState();
}

class _MyStatefulWidgetState extends State<MyStatefulWidget> {
  late TextEditingController _controller;
  
  @override
  void initState() {
    super.initState();
    _controller = TextEditingController();
  }
  
  @override
  void dispose() {
    _controller.dispose();
    super.dispose();
  }
  
  @override
  Widget build(BuildContext context) {
    return TextField(controller: _controller);
  }
}
```

### 3. ConsumerWidget Pattern
```dart
class MyConsumerWidget extends ConsumerWidget {
  const MyConsumerWidget({super.key});
  
  @override
  Widget build(BuildContext context, WidgetRef ref) {
    final state = ref.watch(myProvider);
    
    return state.when(
      data: (data) => DataWidget(data),
      loading: () => CircularProgressIndicator(),
      error: (error, stack) => ErrorWidget(error),
    );
  }
}
```

## Navigation Patterns

### 1. GoRouter Usage
```dart
// Define routes
final router = GoRouter(
  routes: [
    GoRoute(
      path: '/',
      builder: (context, state) => const DashboardScreen(),
    ),
    GoRoute(
      path: '/transactions',
      builder: (context, state) => const TransactionsScreen(),
    ),
    GoRoute(
      path: '/transactions/:id',
      builder: (context, state) {
        final id = state.pathParameters['id']!;
        return TransactionDetailScreen(id: id);
      },
    ),
  ],
);

// Navigation
context.go('/transactions');
context.push('/transactions/123');
context.pop();
```

### 2. Modal Navigation
```dart
// Show bottom sheet
showModalBottomSheet(
  context: context,
  isScrollControlled: true,
  builder: (context) => AddTransactionSheet(),
);

// Show dialog
showDialog(
  context: context,
  builder: (context) => AppDialog(
    title: 'Confirm',
    content: 'Are you sure?',
    actions: [
      AppButton(text: 'Cancel', onPressed: () => Navigator.pop(context)),
      AppButton(text: 'Confirm', onPressed: () => confirm()),
    ],
  ),
);
```

